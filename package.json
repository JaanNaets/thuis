{
  "name": "huishouden",
  "description": "Ons huishouden: aankoopbewijzen, klantenkaarten en meer. Draait op Cloudflare.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "npm run build && vite preview",
    "typecheck": "tsc -b",
    "cf-typegen": "wrangler types --strict-vars=false",
    "db:migrate:local": "wrangler d1 migrations apply huishouden-db --local --config wrangler.jsonc",
    "db:migrate:remote": "wrangler d1 migrations apply huishouden-db --remote --config wrangler.jsonc",
    "deploy": "npm run build && npm run db:migrate:remote && wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "barcode-detector": "^3.2.2",
    "bwip-js": "^4.11.4",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.4.0",
    "zxing-wasm": "^3.1.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wrangler": "^4.151.2"
  },
  "private": true,
  "type": "module"
}
