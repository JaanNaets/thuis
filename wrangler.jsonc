{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "thuis",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-19",
  "observability": { "enabled": true },

  // De React-app wordt als statische bestanden geserveerd.
  // Alleen /api/* gaat langs de Worker; al de rest is de app zelf.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "huishouden-db",
      "database_id": "2fc14175-dc75-4b49-9b1f-a390659e90ca",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "huishouden-bestanden"
    }
  ],

  // Workers AI, om een foto van een etiket te lezen.
  "ai": { "binding": "AI" },

  // Cloudflare Access (zie README, stap 3). Geen geheimen: de Worker gebruikt ze enkel
  // om te controleren dat een aanvraag echt via jullie Access-login kwam.
  "vars": {
    "TEAM_DOMAIN": "https://mute-forest-dbb0.cloudflareaccess.com",
    "POLICY_AUD": "2d8588316b4f2bde4bad5ab221c3f6536612fae5fcffc58823c8d8cdb5369d64"
  }
}
